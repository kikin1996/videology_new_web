rules_version = '2';

// Pravidla pro Firestore Database — vložte do Firebase Console →
// Firestore Database → záložka "Rules" a publikujte.
//
// Model: kolekce "availability" drží jen datum → počet kamer
// (veřejně čitelné, aby kalendář uměl zobrazit obsazené dny) a
// jednou zapsaný dokument už nejde přepsat ani smazat, takže dva
// klienti nemůžou obsadit stejný den. Kolekce "bookings" drží
// kontaktní údaje k objednávce a je čitelná jen z Firebase Console
// (majitel webu), ne z veřejného webu.
service cloud.firestore {
  match /databases/{database}/documents {

    match /availability/{date} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['cameras', 'bookedAt'])
                    && request.resource.data.cameras in [1, 2]
                    && !exists(/databases/$(database)/documents/availability/$(date));
      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasAll(['date', 'cameras', 'name', 'email'])
                    && request.resource.data.cameras in [1, 2]
                    && request.resource.data.date is string
                    && request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if false;
    }
  }
}
